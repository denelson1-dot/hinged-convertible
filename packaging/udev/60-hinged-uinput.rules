# hinged - allow the daemon to create the synthetic SW_TABLET_MODE device.
#
# /dev/uinput is crw------- root:root by default, so creating a virtual input
# device requires root. This grants it to the `input` group instead, so the
# daemon does not need to run as root.
#
# static_node= is required because the uinput module is often not loaded at the
# time udev processes rules, so there is no device to apply the mode to yet.
#
# Only install this if you intend to run switch synthesis.

KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"

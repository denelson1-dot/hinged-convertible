[Unit]
Description=hinged - convertible posture daemon
Documentation=https://github.com/denelson1-dot/hinged-convertible
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hinged daemon
Restart=on-failure
RestartSec=2

# The daemon releases SW_TABLET_MODE and destroys its virtual device on any
# ordinary exit. libinput does NOT resume a suspended keyboard for a device
# that merely disappears while asserting, so a generous stop timeout matters:
# it is the difference between a clean release and being SIGKILLed mid-assert.
KillSignal=SIGTERM
TimeoutStopSec=15

# Hardening. The daemon reads two pseudo-filesystems and writes one device.
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# A wedged daemon that dies to the OOM killer while asserting is exactly the
# case that strands the user without a keyboard. Make it an unlikely victim.
OOMScoreAdjust=-500

[Install]
WantedBy=graphical-session.target

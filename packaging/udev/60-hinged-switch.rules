# hinged - grant read access to posture switch devices only.
#
# Lid and tablet-mode switches live on /dev/input/event*, which is
# crw-rw---- root:input. Rather than adding the user to the `input` group -
# which grants read access to EVERY input device, including the keyboard, and
# effectively permits keylogging by any process in the session - this tags only
# devices udev has identified as switches.
#
# TAG+="uaccess" grants an ACL to the currently active LOCAL session only. It is
# revoked on logout and does not apply to remote sessions.
#
# On an HP ENVY x360 15-bp1xx this matches exactly three devices:
#   event0   Lid Switch              (SW_LID)
#   event11  Intel Virtual Switches  (SW_TABLET_MODE)
#   event12  HP WMI hotkeys          (SW_TABLET_MODE)
# It does not match the keyboard, touchpad, touchscreen or stylus.
#
# Install:
#   sudo install -m644 60-hinged-switch.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# Verify:
#   hinged doctor      # switch devices should read "readable"

SUBSYSTEM=="input", ENV{ID_INPUT_SWITCH}=="1", TAG+="uaccess"
